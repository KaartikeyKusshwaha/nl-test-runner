# Provider: openai | anthropic | openai_compatible
LLM_PROVIDER=openai
# Required model identifier from the provider's current documentation; no model is hard-coded.
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only for OpenAI-compatible endpoints (for example, a compatible hosted provider).
LLM_BASE_URL=

# Runtime budgets
NLQA_MAX_STEPS=30
NLQA_MAX_SECONDS=240
NLQA_MAX_ELEMENTS=60
NLQA_MAX_TOKENS=512
NLQA_ACTION_TIMEOUT_MS=10000
NLQA_ASSERT_TIMEOUT_MS=5000
NLQA_HEADLESS=true
NLQA_JUDGE=true

# Test-data placeholders used as {{NAME}} inside test cases
# CUSTOMER_EMAIL=
# CUSTOMER_PASSWORD=
# PHPTRAVELS_CUSTOMER_URL=
# PHPTRAVELS_CUSTOMER_EMAIL=
# PHPTRAVELS_CUSTOMER_PASSWORD=
# SAUCEDEMO_USERNAME=standard_user
# SAUCEDEMO_PASSWORD=secret_sauce
